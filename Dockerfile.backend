# backend/Dockerfile.backend

# 1. استخدام نسخة بايثون مستقرة ومخففة
FROM python:3.11-slim

# 2. ضبط متغيرات البيئة لمنع بايثون من كتابة ملفات pyc وضمان خروج المخرجات فوراً للـ Logs
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# 3. تحديد مجلد العمل داخل الحاوية
WORKDIR /app

# 4. تثبيت حزم النظام الأساسية المطلوبة لبناء بعض مكتبات بايثون العلمية والشبكات
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# 5. نسخ ملف المتطلبات أولاً للاستفادة من الـ Caching الخاص بدوكر وتسريع البناء مستقبلاً
COPY requirements.txt .

# 6. تحديث pip وتثبيت مكتبات بايثون (بما فيها PyTorch و Stable-Baselines3 و FastAPI)
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# 7. نسخ بقية ملفات المشروع وأوزان الـ DRL المدربة إلى الحاوية
COPY . .

# 8. فتح المنفذ 8000 المخصص لـ FastAPI والـ WebSockets
EXPOSE 8000

# 9. أمر التشغيل باستخدام Uvicorn للإنتاجية العالية والـ WebSockets المستقرة
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]